# Credenciais de acesso ao Rotalog Copel
ROTALOG_USUARIO=seu_usuario_copel
ROTALOG_SENHA=sua_senha_copel

# Configurações do Firebase Storage (GCS)
DDS_BUCKET_NAME=dds-treinamentos.firebasestorage.app
ROTALOG_GCS_ROOT_PREFIX=dados/{empresa}/rotalog
DDS_EMPRESA_PADRAO=ChicoEletro
DDS_TIMEZONE=America/Sao_Paulo

# Ativa upload automático para a nuvem
ROTALOG_UPLOAD_FIREBASE=true

# LED de atividade do Orange Pi (opcional). Descubra os caminhos no equipamento
# com: .venv/bin/python main.py --list-leds
# ROTALOG_LED_ENABLED=true
# ROTALOG_LED_RED_PATH=/sys/class/leds/<led-vermelho>
# ROTALOG_LED_GREEN_PATH=/sys/class/leds/<led-verde>

# Caminho para o arquivo JSON da conta de serviço (se aplicável)
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Identidade e atualização remota deste equipamento
# Use um identificador diferente em cada Orange Pi.
FLEET_NODE_ID=orange-01
# Deve apontar ao mesmo diretório passado ao coletor em --output-dir.
# FLEET_DATA_DIR=/home/orangepi/dds-coletor-rtl/dados-local
FLEET_SERVICE_NAME=rotalog.service
FLEET_GIT_REMOTE=origin
FLEET_RUN_TESTS=true
FLEET_INSTALL_REQUIREMENTS=true
FLEET_HEALTH_TIMEOUT_SECONDS=45
FLEET_LOCAL_HEARTBEAT_SECONDS=120
TUI_HEALTH_INTERVAL_SECONDS=120
# No Windows, pode apontar para uma credencial administrativa separada.
# FLEET_GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\fleet-admin.json
