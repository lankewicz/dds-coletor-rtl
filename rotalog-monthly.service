[Unit]
Description=DDS Rotalog - fechamento mensal recuperavel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/dds-coletor-rtl
EnvironmentFile=/home/orangepi/dds-coletor-rtl/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/orangepi/dds-coletor-rtl/.venv-3.14/bin/python main.py --reconciliar-agendado --firebase --output-dir /home/orangepi/dds-coletor-rtl/dados-local
TimeoutStartSec=24h
Nice=5
