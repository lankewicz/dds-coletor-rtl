[Unit]
Description=DDS Rotalog - Coleta unica e reconciliacao diaria
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/dds-coletor-rtl
EnvironmentFile=/home/orangepi/dds-coletor-rtl/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/orangepi/dds-coletor-rtl/.venv-3.14/bin/python -m scripts.rotalog_daily_pipeline
TimeoutStartSec=0
Nice=5
