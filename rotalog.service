[Unit]
Description=DDS Coletor Rotalog - Daemon de Raspagem e Sincronizacao (Orange Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
Group=orangepi

# O processo continua como "orangepi", com a capacidade necessária para
# gravar os atributos de LED expostos pelo kernel em /sys/class/leds.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE

# Diretorio de instalacao no Orange Pi
WorkingDirectory=/home/orangepi/dds-coletor-rtl

# Variaveis de ambiente carregadas do .env local
EnvironmentFile=/home/orangepi/dds-coletor-rtl/.env
Environment=PYTHONUNBUFFERED=1
Environment=ROTALOG_UPLOAD_FIREBASE=true

# Executável Python 3.14 do ambiente isolado do coletor.
# O Python 3.10 do Ubuntu permanece reservado ao sistema operacional.
ExecStart=/home/orangepi/dds-coletor-rtl/.venv-3.14/bin/python main.py --firebase --output-dir /home/orangepi/dds-coletor-rtl/dados-local

# Politica de reinicio automatico resiliente a quedas de rede e reboots
Restart=always
RestartSec=10

# Protecao de memoria e prioridade de I/O
Nice=-5
MemoryMax=256M
LimitNOFILE=65535

# Logs direcionados para o systemd journal (journalctl -u rotalog -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
